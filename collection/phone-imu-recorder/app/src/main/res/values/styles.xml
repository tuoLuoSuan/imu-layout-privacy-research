<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="BodyText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="SectionTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_action</item>
        <item name="android:textColor">@color/action_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="NavButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_nav</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
