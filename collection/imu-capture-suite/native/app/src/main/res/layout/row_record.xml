<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="18dp" android:minHeight="88dp" android:background="@drawable/bg_record" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:importantForAccessibility="noHideDescendants">
        <TextView android:id="@+id/record_date" style="@style/SectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" />
        <RadioButton android:id="@+id/record_radio" android:layout_width="48dp" android:layout_height="48dp" android:buttonTint="@color/accent" android:clickable="false" android:focusable="false" android:background="@null" />
    </LinearLayout>
    <TextView android:id="@+id/record_short_id" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/record_frequency" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:layout_marginTop="5dp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/record_quality" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:importantForAccessibility="no" />
</LinearLayout>
