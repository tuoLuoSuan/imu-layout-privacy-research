#!/bin/sh
set -eu
while read local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    case "$remote_oid" in
        0000000000000000000000000000000000000000) commits=$(git rev-list "$local_oid") ;;
        *) commits=$(git rev-list "$remote_oid..$local_oid") ;;
    esac
    for revision in $commits; do
        python tools/repository_guard.py --revision "$revision" --report "backups/pre-push-$revision.json" || {
            echo "Source check rejected push at $revision. See backups/pre-push-$revision.json." >&2
            exit 1
        }
    done
done
